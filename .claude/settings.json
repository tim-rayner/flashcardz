{
  "enabledPlugins": {
    "nx@nx-claude-plugins": true,
    "mattpocock-skills@mattpocock": true
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": ["www.google-analytics.com"]
    }
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npx nx:*)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": ["Bash(git push --force:*)", "Bash(rm -rf:*)"]
  }
}
